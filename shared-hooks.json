{
    "hooks": {
        "UserPromptSubmit": [{
            "hooks": [{
                "type": "command",
                "command": "printf '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Now (Chicago): %s\"}}' \"$(TZ=America/Chicago date '+%b %-d, %-I:%M %p')\"",
                "timeout": 5
            }]
        }],

        "PreToolUse": [{
            "matcher": "Bash",
            "hooks": [{
                "type": "command",
                "command": "~/.claude/hooks/block-selfkill.sh"
            }]
        }],

        "PostToolUse": [{
            "matcher": "*",
            "hooks": [{
                "type": "command",
                "command": "printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"Now (Chicago): %s\"}}' \"$(TZ=America/Chicago date '+%b %-d, %-I:%M %p')\"",
                "timeout": 5
            }]
        }]
    }
}
